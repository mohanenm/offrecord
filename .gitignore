# Python, build output and caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/

# Never commit run-time artefacts: they may contain real transcript data.
*.mapping
*.mapping.enc
*.audit
*.audit.enc
*.key
*.pem
*.passphrase
.env
.env.*
out/
runs/

# Private, hand-labelled evaluation data lives OUTSIDE the repo. Belt and braces:
eval/private/
private/

# Model files are fetched by `offrecord setup`, never committed.
/models/
*.onnx
*.gguf

# Local config may list real clients and codenames.
offrecord.local.yaml
*.local.yaml

.DS_Store

# Personal working notes and assistant settings stay local.
/notes/
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
